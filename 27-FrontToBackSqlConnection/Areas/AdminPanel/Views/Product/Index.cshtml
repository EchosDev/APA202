@model List<ProductGetVM>
@{
    int count = 0;
}
<div class="row">

    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Products</h4>
                <a asp-action="create" class="btn btn-outline-success btn-fw">Add Product</a>
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>
                                    №
                                </th>
                                <th>
                                    Image
                                </th>
                                <th>
                                    Name
                                </th>
                                <th>
                                    Price
                                </th>
                                <th>
                                    Sku
                                </th>
                                <th>
                                    CategoryName
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in Model)
                            {
                                <tr>
                                    <td>
                                        @(++count)
                                    </td>
                                    <td>
                                        <img style="width: 50px;height:50px" src="~/assets/images/website-images//@product?.Image" />
                                    </td>
                                    <td>
                                        @product.Name
                                    </td>
                                    <td>
                                        @product.Price
                                    </td>
                                    <td>
                                        @product.Sku
                                    </td>
                                    <td>
                                        @product.CategoryName
                                    </td>
                                    <td>
                                        <a asp-action="update" asp-route-id="@product.ProductId" class="btn btn-outline-warning btn-fw">Edit</a>
                                        <a asp-action="detail" asp-route-id="@product.ProductId" class="btn btn-outline-info btn-fw">Detail</a>
                                        <a asp-action="delete" asp-route-id="@product.ProductId" class="btn btn-outline-danger btn-fw">Delete</a>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
