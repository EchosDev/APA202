@model ProductUpdateVM

<div class="col-md-6 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Update Product</h4>
            <form class="forms-sample" method="post" enctype="multipart/form-data">
                <div class="form-group">
                    <div><img style="width: 100px;height:100px" src="~/assets/images/website-images/@Model.ProductImages.FirstOrDefault(pi => pi.IsPrimary == true)?.Image" /></div>
                    <label for="MainPhoto">Main Photo</label>
                    <input asp-for="MainPhoto" class="form-control" accept="image/*">
                    <span asp-validation-for="MainPhoto" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <div><img style="width: 100px;height:100px" src="~/assets/images/website-images/@Model.ProductImages.FirstOrDefault(pi => pi.IsPrimary == false)?.Image" /></div>
                    <label for="HoverPhoto">Secondary Photo</label>
                    <input asp-for="HoverPhoto" class="form-control" accept="image/*">
                    <span asp-validation-for="HoverPhoto" class="text-danger"></span>
                </div>
                <div class="form-group d-flex flex-lg-column">
                    @foreach (var additionalPhoto in Model.ProductImages.Where(pi => pi.IsPrimary == null))
                    {
                        <div class="position-relative">
                            <img style="width: 100px;height:100px" src="~/assets/images/website-images/@additionalPhoto.Image" />
                            <i style="cursor: pointer; font-size: 20px; position: absolute; top: 3px; right: 3px;" class="custom-btn mdi mdi-close-circle"></i>
                            <input asp-for="ImageIds" type="hidden" value="@additionalPhoto.Id" />
                        </div>
                    }   
                </div>

                <div class="form-group">
                    <label for="AdditionalPhotos">Additional Photos</label>
                    <input asp-for="AdditionalPhotos" class="form-control" accept="image/*">
                    <span asp-validation-for="ImageIds" class="text-danger"></span>
                </div>



                <div class="form-group">
                    <label for="Name">Name</label>
                    <input asp-for="Name" class="form-control" placeholder="Name">
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label for="Price">Price</label>
                    <input asp-for="Price" class="form-control" placeholder="Price">
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label for="Sku">Sku</label>
                    <input asp-for="Sku" class="form-control" placeholder="Sku">
                    <span asp-validation-for="Sku" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label for="CategoryId">Category</label>
                    <select asp-for="CategoryId" asp-items="new SelectList(Model.Categories, nameof(Category.Id), nameof(Category.Name))" class="form-control">
                        <option value="" disabled selected>Choose Category</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label for="TagIds">Tag</label>
                    <select asp-for="TagIds" asp-items="new SelectList(Model.Tags, nameof(Tag.Id), nameof(Tag.Name))" class="form-control" multiple>
                        <option value="" disabled selected>Choose Tags</option>
                    </select>
                    <span asp-validation-for="TagIds" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label for="Description">Description</label>
                    <textarea asp-for="Description" class="form-control" placeholder="Description"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary me-2">Submit</button>
                <a asp-action="index" class="btn btn-light">Cancel</a>
            </form>
        </div>
    </div>
</div>

<script>
    let btns = document.querySelectorAll('.custom-btn');

    for (let i = 0; i < btns.length; i++) {
        btns[i].addEventListener('click', () => {
            btns[i].parentElement.remove();
        });
    }

</script>